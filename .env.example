# All optional. Anything left unset can be configured in the web UI at /settings.

# QUEUE_WARDEN_IMAGE=ghcr.io/gitsumhubs/queue-warden:latest
# QUEUE_WARDEN_PORT=3020
# QUEUE_WARDEN_CONFIG_PATH=./data/config
# QUEUE_WARDEN_STATE_PATH=./data/state
# QUEUE_WARDEN_LOG_LEVEL=INFO
# TZ=Europe/London

# Report only, remove nothing. Recommended for the first day.
# QUEUE_WARDEN_DRY_RUN=true

# Use host.docker.internal for services running on the Docker host,
# or the container name for services on a shared Docker network.
# SONARR_URL=http://host.docker.internal:8989
# SONARR_API_KEY=
# RADARR_URL=http://host.docker.internal:7878
# RADARR_API_KEY=
# BOOKMARKARR_URL=http://host.docker.internal:3018
# BOOKMARKARR_API_KEY=
# DOWNLOAD_CLIENT_URL=http://host.docker.internal:6500
# DOWNLOAD_CLIENT_USERNAME=
# DOWNLOAD_CLIENT_PASSWORD=
